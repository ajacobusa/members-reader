# ---------------------------------------------------------------------------
# Wireless Ops — environment template. Copy to `.env.local` and fill in.
# The app boots WITHOUT any of these (mock data + auth disabled in dev).
# ---------------------------------------------------------------------------

# Database — Vercel Marketplace Postgres / Neon (pooled connection string).
# Leave unset to run on the in-memory mock data layer.
DATABASE_URL=

# Clerk auth. When the publishable key is present, auth is enforced; when
# absent, the dashboard is open (dev convenience).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk webhook (events: session.created/ended, user.created) → login activity
# in the audit log. Endpoint: POST /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# Inngest (background jobs). Optional for local dev (`npx inngest-cli dev`).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Admin endpoint (/api/admin/db-setup) — long random secret. When set, a
# Bearer-authenticated POST migrates + reseeds the database from inside the
# deployment (useful when DATABASE_URL is a write-only/sensitive env var).
# Leave unset to keep the endpoint disabled.
ADMIN_TASK_TOKEN=

# Encrypts vendor API credentials (AES-256-GCM) before they are stored in the
# integrations table. Any strong random passphrase. Required to save
# credentials via /api/admin/integrations; without it, writes are refused.
CREDENTIALS_ENCRYPTION_KEY=

# AI layer — Vercel AI Gateway. With a key, summaries/reports use a Claude model;
# without one, the app serves a deterministic rule-based summary instead.
# Find current model ids: curl -s https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5

# Aruba Central integration (filled per-company at runtime via the
# integrations table; these are fallbacks/defaults for a single-tenant dev setup).
ARUBA_BASE_URL=
ARUBA_CLIENT_ID=
ARUBA_CLIENT_SECRET=
ARUBA_CUSTOMER_ID=
