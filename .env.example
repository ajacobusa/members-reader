# QuoteForge Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Pipeline Mode ─────────────────────────────────────────────────
# TEST_MODE=true  → generates mock outputs without calling real APIs
# TEST_MODE=false → live mode, all API calls are real
TEST_MODE=true

# ── AI Quote Generation ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Image Rendering ───────────────────────────────────────────────
BANNERBEAR_API_KEY=your_bannerbear_api_key
BANNERBEAR_TEMPLATE_UID=your_bannerbear_template_uid
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ── Airtable (optional — for team visibility) ─────────────────────
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_ORDERS_TABLE=Orders
AIRTABLE_PRODUCTS_TABLE=Products
AIRTABLE_TEMPLATES_TABLE=Templates

# ── Gelato API (programmatic order creation) ──────────────────────
GELATO_API_KEY=your_gelato_api_key
GELATO_BASE_URL=https://order.gelatoapis.com

# ── Canva API (optional — falls back to Bannerbear) ──────────────
CANVA_API_KEY=your_canva_api_key
CANVA_BRAND_TEMPLATE_ID=your_canva_template_id

# ── Google Drive (optional — falls back to local storage) ─────────
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json

# ── Etsy API ──────────────────────────────────────────────────────
ETSY_SHOP_ID=your_etsy_shop_id
ETSY_API_KEY=your_etsy_api_key
ETSY_WEBHOOK_SECRET=your_etsy_webhook_hmac_secret

# ── Pipeline Settings ─────────────────────────────────────────────
PIPELINE_AUTO_APPROVE_PROOF=false
PIPELINE_REVIEW_DELAY_DAYS=14
PIPELINE_UPSELL_DELAY_HOURS=2

# ── Output ────────────────────────────────────────────────────────
# Defaults to ~/Desktop/QuoteForge-Output — override here if needed
# OUTPUT_DIR=C:/Users/you/Documents/QuoteForge
