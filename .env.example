# QuoteForge Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Pipeline Mode ─────────────────────────────────────────────────
# TEST_MODE=true  → generates mock outputs without calling real APIs
# TEST_MODE=false → live mode, all API calls are real
TEST_MODE=true

# ── AI Quote Generation ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Image Rendering ───────────────────────────────────────────────
BANNERBEAR_API_KEY=your_bannerbear_api_key
BANNERBEAR_TEMPLATE_UID=your_bannerbear_template_uid
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ── Airtable (optional — for team visibility) ─────────────────────
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_ORDERS_TABLE=Orders
AIRTABLE_PRODUCTS_TABLE=Products
AIRTABLE_TEMPLATES_TABLE=Templates

# ── Gelato API (programmatic order creation) ──────────────────────
GELATO_API_KEY=your_gelato_api_key
GELATO_BASE_URL=https://order.gelatoapis.com

# ── Printify API (optional second POD vendor; orders auto-route by vendor) ──
# Key: printify.com → My Profile → Connections → API tokens
# Shop ID: GET https://api.printify.com/v1/shops.json with the token
PRINTIFY_API_KEY=your_printify_api_key
PRINTIFY_SHOP_ID=your_printify_shop_id

# ── Printful API (optional second POD vendor; orders auto-route by vendor) ──
# Key: printful.com → Settings → Stores → API (private token)
PRINTFUL_API_KEY=your_printful_api_key

# ── Canva API (optional — falls back to Bannerbear) ──────────────
CANVA_API_KEY=your_canva_api_key
CANVA_BRAND_TEMPLATE_ID=your_canva_template_id

# ── Google Drive (optional — falls back to local storage) ─────────
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json

# ── Etsy API ──────────────────────────────────────────────────────
ETSY_SHOP_ID=your_etsy_shop_id
ETSY_API_KEY=your_etsy_api_key
ETSY_WEBHOOK_SECRET=your_etsy_webhook_hmac_secret

# ── Margins (net %, after Gelato cost + Etsy fees) ───────────────
# 60% is the absolute floor everywhere. You can raise an upsell tier's floor as
# sales justify (entry=Poster, mid=Framed, top=Canvas/Acrylic/Metal); a tier can
# never go below TARGET_MARGIN_PCT. Pricing auto-recomputes to the floor.
TARGET_MARGIN_PCT=60
MARGIN_FLOOR_ENTRY=60
MARGIN_FLOOR_MID=60
MARGIN_FLOOR_TOP=60

# ── Pipeline Settings ─────────────────────────────────────────────
PIPELINE_AUTO_APPROVE_PROOF=false
PIPELINE_REVIEW_DELAY_DAYS=14
PIPELINE_UPSELL_DELAY_HOURS=2

# ── UAT / feedback collection (optional) ─────────────────────────
# Paste a Google Form (or any survey) URL to route the UAT shop-home page's
# feedback buttons to it (listing title + star rating appended to the URL) so
# responses auto-aggregate to a sheet. Leave blank to use mailto-to-owner.
FEEDBACK_FORM_URL=

# ── Off-site backup to Google Drive (optional) ───────────────────
# Set true to also upload the DB snapshot + git bundle to Drive on backup-all
# (reuses GOOGLE_* creds above). No-op if Drive isn't configured.
BACKUP_TO_DRIVE=false
BACKUP_DRIVE_FOLDER=Joffiels-Backups

# ── Error monitoring (optional, for public hosting) ──────────────
# Set a Sentry DSN to capture unhandled errors in the webhook server + admin.
# Requires `pip install sentry-sdk`. No-op when blank.
SENTRY_DSN=

# ── Audience / email capture (optional) ─────────────────────────
# Your mailing-list signup form (Mailchimp/MailerLite/Google Form/website).
# Used by `email-capture` for the QR code, Linktree, announcement + insert CTA.
SIGNUP_URL=
LINKTREE_URL=

# ── Pinterest auto-publish (optional, fully hands-free when set) ──
# With a token + board id AND PINTEREST_AUTOPILOT=true, the weekly scheduled
# job posts pins automatically. Without them it still regenerates images+CSV.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_AUTOPILOT=false

# ── Web analytics on the shop-home page (optional) ──────────────
# No-ops when blank. Etsy Shop Stats needs no code (enable inside Etsy).
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# ── Affiliate "complete the gift" + B2B (your own site, NOT Etsy) ─
# Paste your affiliate referral links (you earn commission). Each shows only if
# set; FTC disclosure is auto-added. NEVER use these on Etsy (off-site links are
# banned there). B2B email receives wholesale/bulk-gifting inquiries.
AFFILIATE_FLOWERS_URL=
AFFILIATE_GIFTCARD_URL=
AFFILIATE_GIFTS_URL=
# Add ANY number of programs at once (run `affiliates` for the apply directory):
# AFFILIATE_LINKS_JSON={"1-800-Flowers":"https://...","Amazon":"https://...","UrbanStems":"https://..."}
AFFILIATE_LINKS_JSON=
B2B_CONTACT_EMAIL=

# ── Off-site backup to Google Drive (optional) ───────────────────
# Nightly backup also uploads the DB + code bundle to a Drive folder.
# Setup: create a Google Cloud service account, download its JSON key, share a
# Drive folder with the service-account email, then set the 3 values below.
BACKUP_TO_DRIVE=0
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ── Storefront checkout (Model A: Etsy is the checkout) ───────────
# Your live Etsy shop URL. Once set, the storefront's "Continue to checkout"
# button sends customers to your shop to pay. Publish your listings first.
# Example: https://www.etsy.com/shop/Joffiels
ETSY_SHOP_URL=

# ── Output ────────────────────────────────────────────────────────
# Defaults to ~/Desktop/QuoteForge-Output — override here if needed
# OUTPUT_DIR=C:/Users/you/Documents/QuoteForge
