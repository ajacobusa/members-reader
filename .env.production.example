# =============================================================================
# QuoteForge — PRODUCTION environment template
# =============================================================================
# Copy this file to `.env` ON THE PRODUCTION SERVER and fill in real values.
# NEVER commit a filled-in copy (real secrets) to git — only this template.
#
# Sections:
#   [1] REQUIRED FOR GO-LIVE — production breaks / orders won't route without these
#   [2] RECOMMENDED          — strongly suggested for a healthy launch
#   [3] OPTIONAL             — extra integrations; safe to leave unset
#
# Verify after editing:  python -m quoteforge.admin verify-keys
#                        python -m quoteforge.admin preflight
#                        python -m quoteforge.admin deploy-status
# =============================================================================


# -----------------------------------------------------------------------------
# [1] REQUIRED FOR GO-LIVE
# -----------------------------------------------------------------------------

# Turn OFF test mode so real Etsy / Gelato / Claude calls run. (Default true=safe.)
TEST_MODE=false

# --- Claude (quote + artwork generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gelato (print fulfilment) ---
GELATO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# IMPORTANT: replace every placeholder product UID (GEL-POSTER-8X10-STD, …) in
# quoteforge/etsy/gelato_catalog.py with the REAL UID from your Gelato account.
# Orders CANNOT route while any placeholder remains. The daily `gelato-sync` job
# now fails loudly + emails you if any placeholder is still present in live mode.
GELATO_WEBHOOK_SECRET=

# --- Etsy (order polling + tracking push) ---
ETSY_API_KEY=
ETSY_OAUTH_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_WEBHOOK_SECRET=
ETSY_API_BASE=https://openapi.etsy.com/v3

# --- Print-file hosting (Gelato must be able to FETCH the customer's JPG) ---
# Use EITHER Google Drive OR a public file dir. Without one, Gelato can't get the
# print file and fulfilment fails.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# ...OR a public directory served over HTTPS:
PUBLIC_FILE_DIR=/var/www/quoteforge/files
PUBLIC_FILE_BASE_URL=https://files.yourstore.com

# --- Hosted backend URL (storefront widgets + the /service-request claim form) ---
# Point this at the running webhook server's /ask endpoint; the others are derived.
ASK_ANGE_API_URL=https://api.yourstore.com/ask

# --- Carrier tracking (carrier-confirmed delivery only runs when this is set) ---
TRACKING_API_KEY=
TRACKING_API_PROVIDER=aftership

# --- Owner email + alerts (Gmail SMTP app password) ---
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPORT_RECIPIENT=you@gmail.com

# --- Storage (persistent, writable, backed up) ---
OUTPUT_DIR=/data/quoteforge-output


# -----------------------------------------------------------------------------
# [2] RECOMMENDED
# -----------------------------------------------------------------------------
SHOP_NAME=YourStore
ETSY_SHOP_URL=https://www.yourstore.etsy.com
CLAUDE_MODEL=claude-haiku-4-5
RENDERER=local

# Claim / return policy windows (calendar days). 7-day customer window nests
# inside Gelato's 30-day quality guarantee.
CLAIM_REPORT_DAYS=7
CLAIM_FLAG_DAYS=30
SUPPLIER_CLAIM_DAYS=30
POLICY_DEFECT_WINDOW_DAYS=7
POLICY_LOST_WINDOW_DAYS=30

# Margins / pricing guardrails
TARGET_MARGIN_PCT=60
LIST_MARGIN_PCT=65
SHIPPING_VARIANCE_ALERT_PCT=10

# Fulfilment + review timing
PRODUCTION_DAYS=3
SHIPPING_DAYS=5
PIPELINE_REVIEW_DELAY_DAYS=6

# Error monitoring
SENTRY_DSN=

# Backups
BACKUP_RETENTION_DAYS=30
BACKUP_DRIVE_FOLDER=


# -----------------------------------------------------------------------------
# [3] OPTIONAL (extra vendors, analytics, marketing — safe to leave unset)
# -----------------------------------------------------------------------------
# AI super-resolution (premium photo "ENHANCE" tier). Without these, a borderline
# customer photo is upscaled with the offline Lanczos baseline (capped 2x). Set a
# provider to upscale at up to 4x with real detail recovery (Real-ESRGAN/GFPGAN).
# AI_PHOTO_ENHANCE defaults ON; set false to disable enhancement entirely.
AI_PHOTO_ENHANCE=true
# Provider: "generic" (your own sync SR server) or "replicate" (async Real-ESRGAN).
AI_UPSCALE_PROVIDER=
AI_UPSCALE_API_KEY=
# generic: your endpoint (multipart image in -> upscaled image bytes / JSON url out)
# replicate: leave blank to use https://api.replicate.com/v1/predictions
AI_UPSCALE_API_URL=
# replicate only: the model version id (e.g. a Real-ESRGAN version on Replicate)
AI_UPSCALE_MODEL=

# Wave accounting API (push per-order Etsy payouts as money transactions).
# Create a Full-Access token in Wave (no Wave Pro needed for a personal token).
# Then: `admin wave-test` prints your business + account IDs -> fill these ->
# `admin wave-sync month` (dry-run) -> add --live to push.
WAVE_API_TOKEN=
WAVE_BUSINESS_ID=
WAVE_ACCT_BANK=
WAVE_ACCT_SALES=
WAVE_ACCT_SHIPPING=
WAVE_ACCT_FEES=

# Additional print vendors (only if you use them)
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
PRINTFUL_API_KEY=

# Analytics
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# Image sources
UNSPLASH_ACCESS_KEY=
BANNERBEAR_API_KEY=

# Marketing
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
SIGNUP_URL=
LINKTREE_URL=
B2B_CONTACT_EMAIL=

# Payment link (manual checkout fallback)
PAYMENT_LINK_URL=

# Competitor tracking (comma-separated shop slugs)
COMPETITORS=

# Gelato product mapping (replace placeholders before go-live):
#   GELATO_PRODUCT_FAMILY_FILE - apparel/mug/calendar/branded family map
#     (build a draft with `python -m quoteforge.admin gelato-automap`).
#   GELATO_UID_MAP_FILE - static our_sku -> UID map incl. Wall Art
#     (build a draft with `python -m quoteforge.admin wallart-automap`).
GELATO_PRODUCT_FAMILY_FILE=
GELATO_UID_MAP_FILE=

# Product-photo agent (optional): a published Google-Sheet CSV link
# (File -> Share -> Publish to web -> CSV). When set, the weekly product-photos
# agent reads image URLs straight from the live sheet - the owner never touches a
# local file. Leave blank to use the local config/product_photos.csv instead.
PRODUCT_PHOTOS_SHEET_URL=
